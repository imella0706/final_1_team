# [Design Intent] This file documents required variables only. Use
# scripts/airflow/up.sh to generate a private .env.airflow with random secrets.
AIRFLOW_UID=1000
AIRFLOW_WEB_PORT=8080

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace-with-random-admin-password
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_FIRSTNAME=BrandMate
AIRFLOW_ADMIN_LASTNAME=Admin

AIRFLOW__CORE__FERNET_KEY=replace-with-valid-fernet-key
AIRFLOW__WEBSERVER__SECRET_KEY=replace-with-random-webserver-secret

# [Design Intent] Phase 2 reads processed artifacts from GCS and writes
# validation summaries to this logs prefix. Local runs use ADC from gcloud.
BRANDMATE_AIRFLOW_GCS_LOGS_PREFIX=gs://ssakda/projects/brandmate/logs/data_pipeline/airflow
GOOGLE_CLOUD_PROJECT=ssakda
