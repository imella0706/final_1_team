# [Design Intent] This file documents required variables only. Use
# scripts/airflow/up.sh to generate a private .env.airflow with random secrets.
AIRFLOW_UID=1000
AIRFLOW_WEB_PORT=8080

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace-with-random-admin-password
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_ADMIN_FIRSTNAME=BrandMate
AIRFLOW_ADMIN_LASTNAME=Admin

AIRFLOW__CORE__FERNET_KEY=replace-with-valid-fernet-key
AIRFLOW__WEBSERVER__SECRET_KEY=replace-with-random-webserver-secret

# [Design Intent] Phase 2 reads processed artifacts from GCS and writes
# validation summaries to this logs prefix. Local runs use ADC from gcloud.
BRANDMATE_AIRFLOW_GCS_LOGS_PREFIX=gs://ssakda/projects/brandmate/logs/data_pipeline/airflow

# [Design Intent] Phase 3 keeps the DAG manual by default, but allows local/VM
# Airflow to discover and validate the latest immutable sns_trend processed vN.
BRANDMATE_SNS_TREND_PROCESSED_GCS_ROOT=gs://ssakda/projects/brandmate/data/processed/sns_trend/
BRANDMATE_SNS_TREND_VALIDATION_SCHEDULE=
BRANDMATE_SNS_TREND_SAME_VERSION_POLICY=skip

# [Design Intent] Phase 4 keeps YouTube landing collection manual by default.
# Store the real API key only in private .env.airflow, never in Git.
YOUTUBE_API_KEY=replace-with-youtube-api-key
YOUTUBE_REGION_CODE=KR
YOUTUBE_TOTAL_VIDEOS=100
YOUTUBE_PAGE_SIZE=50
YOUTUBE_API_TIMEOUT=15
YOUTUBE_API_RETRIES=3
YOUTUBE_TOKENIZER=regex
YOUTUBE_TIMEZONE=Asia/Seoul
BRANDMATE_SNS_TREND_YOUTUBE_LANDING_SCHEDULE=
BRANDMATE_SNS_TREND_YOUTUBE_LANDING_LIMIT=100

# [Design Intent] Phase 4 keeps Gogumafarm landing collection manual by default.
BRANDMATE_SNS_TREND_GOGUMAFARM_LANDING_SCHEDULE=
BRANDMATE_SNS_TREND_GOGUMAFARM_CURATED_VERSION=v3
BRANDMATE_SNS_TREND_GOGUMAFARM_DELAY=1.0
BRANDMATE_SNS_TREND_GOGUMAFARM_TIMEOUT=15
BRANDMATE_SNS_TREND_GOGUMAFARM_RETRIES=3

BRANDMATE_AIRFLOW_ALERTS_ENABLED=false
BRANDMATE_AIRFLOW_DISCORD_WEBHOOK_URL=
BRANDMATE_AIRFLOW_ALERT_TIMEOUT_SECONDS=5

GOOGLE_CLOUD_PROJECT=ssakda
