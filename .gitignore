# Local / large datasets
# [Design Intent] Keep large dataset files out of Git while allowing DVC
# pointer files under data/ to be committed.
/data/**
!/data/**/
!/data/**/*.dvc

# [Design Intent] gather_data는 크롤러 코드와 명세만 추적하고, 생성된
# 크롤링 산출물은 repository root의 data/ 계층 또는 로컬 runtime 경로에서 관리한다.
/gather_data/processed/
/gather_data/trendcard copy.json
/gather_data/crawling/*/data/
/gather_data/crawling/*/data-smoke/
/gather_data/crawling/*/data-smoke-detail/
/gather_data/naver/*.csv
/gather_data/naver/*.png
/gather_data/youtube/*.csv
/gather_data/youtube/*.png
/gather_data/youtube/history/
/gather_data/youtube/data/
/gather_data/youtube/reports/
/gather_data/**/.agents/

