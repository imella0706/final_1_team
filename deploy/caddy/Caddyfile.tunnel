:8080 {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; script-src 'self'; worker-src 'self'; manifest-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}

	@pwa_metadata path / /index.html /manifest.webmanifest /sw.js
	header @pwa_metadata Cache-Control "no-cache, no-store, must-revalidate"

	@manifest path /manifest.webmanifest
	header @manifest >Content-Type "application/manifest+json; charset=utf-8"

	@api path /api /api/*
	@cross_site_api {
		path /api /api/*
		header Sec-Fetch-Site cross-site
	}
	@invalid_api_origin {
		path /api /api/*
		expression `{http.request.header.Origin} != "" && {http.request.header.Origin} != "https://" + {http.request.host}`
	}

	route {
		respond /__brandmate_proxy_health "ok" 200

		respond @cross_site_api `{"detail":"cross-site API request blocked"}` 403
		respond @invalid_api_origin `{"detail":"invalid API origin"}` 403

		reverse_proxy @api {$BRANDMATE_API_UPSTREAM:host.docker.internal:7660} {
			header_up -Origin
			header_up X-Forwarded-Proto "https"
			header_down Set-Cookie "(.*)" "$1; Secure"
			header_down Cache-Control "no-store"
			header_down Pragma "no-cache"
		}

		reverse_proxy {$BRANDMATE_WEB_UPSTREAM:host.docker.internal:5501}
	}
}
