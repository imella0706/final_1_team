# GCP VM에서 사용할 BrandMate API 환경 변수 예시입니다.
# 이 파일을 apps/api/.env로 복사한 뒤 자리표시자 값을 실제 값으로 교체하세요.

# 운영 인증/DB 설정. 아래 자리표시자를 실제 Secret Manager/DB 값으로 교체하세요.
# [Design Intent] 인증 설정의 배포 기준은 이 파일 하나이며, 운영에서 안전하지
# 않은 secret/cookie/DB 조합은 애플리케이션 시작 단계에서 거부합니다.
BRANDMATE_ENVIRONMENT=production
# PASSWORD에 @, :, / 같은 문자가 있으면 URL percent-encoding이 필요합니다.
BRANDMATE_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@PRIVATE_DB_HOST:5432/brandmate
# 생성 예시: openssl rand -hex 32 (replace-me 상태에서는 서버 시작 실패)
BRANDMATE_AUTH_SECRET_KEY=replace-me
BRANDMATE_AUTH_JWT_ALGORITHM=HS256
BRANDMATE_AUTH_JWT_ISSUER=brandmate-api
BRANDMATE_AUTH_JWT_AUDIENCE=brandmate-web
BRANDMATE_AUTH_ACCESS_TOKEN_MINUTES=10
BRANDMATE_AUTH_REFRESH_TOKEN_DAYS=14
BRANDMATE_AUTH_REFRESH_COOKIE_NAME=__Host-brandmate_refresh
BRANDMATE_AUTH_REFRESH_COOKIE_SECURE=true
BRANDMATE_AUTH_REFRESH_COOKIE_SAMESITE=lax
# 공개 가입은 반드시 이메일 소유권 확인을 요구합니다.
BRANDMATE_AUTH_EMAIL_VERIFICATION_REQUIRED=true
BRANDMATE_AUTH_EMAIL_VERIFICATION_HOURS=24
BRANDMATE_AUTH_PASSWORD_RESET_MINUTES=30
# [Design Intent] 회원 생성과 메일 발송을 분리하고, SMTP 장애는 DB Outbox에서
# 제한적으로 재시도합니다. 실제 SMTP 자격 증명은 Secret Manager로 주입하세요.
BRANDMATE_AUTH_EMAIL_DELIVERY_ENABLED=true
# HTTPS 프록시 실행 시 BRANDMATE_DOMAIN과 같은 origin을 사용합니다.
BRANDMATE_AUTH_PUBLIC_WEB_URL=https://brandmate.example.com
BRANDMATE_AUTH_SMTP_HOST=smtp.example.com
BRANDMATE_AUTH_SMTP_PORT=587
BRANDMATE_AUTH_SMTP_USERNAME=replace-me
BRANDMATE_AUTH_SMTP_PASSWORD=replace-me
BRANDMATE_AUTH_SMTP_FROM_EMAIL=no-reply@brandmate.example.com
BRANDMATE_AUTH_SMTP_STARTTLS=true
BRANDMATE_AUTH_EMAIL_TIMEOUT_SECONDS=10
BRANDMATE_AUTH_OUTBOX_POLL_SECONDS=2
BRANDMATE_AUTH_OUTBOX_MAX_ATTEMPTS=5
# PostgreSQL 원자 카운터를 사용해 여러 API worker가 제한을 공유합니다.
BRANDMATE_AUTH_RATE_LIMIT_BACKEND=postgres
BRANDMATE_AUTH_SIGNUP_LIMIT_PER_5_MINUTES=5
BRANDMATE_AUTH_LOGIN_LIMIT_PER_5_MINUTES=10
BRANDMATE_AUTH_LOGIN_IP_LIMIT_PER_5_MINUTES=50
BRANDMATE_AUTH_REFRESH_LIMIT_PER_MINUTE=30

# 로컬/OpenAI 호환 LLM 엔드포인트 설정
BRANDMATE_LOCAL_LLM_BASE_URL=

# Qwen 로컬 실행 설정
# GCP VM 안에서 Ollama로 qwen2.5:7b-instruct를 실행할 때 사용한다.
# 그러나 GCP에서 Ollama를 사용하려면 관리자에게 sudo 권한을 받아야 한다.
# BRANDMATE_QWEN_BASE_URL=http://127.0.0.1:11434/v1
# BRANDMATE_QWEN_MODEL=qwen2.5:7b-instruct

# 라마 로컬 실행 설정
BRANDMATE_LLAMA_BASE_URL=http://localhost:1234/v1
BRANDMATE_LLAMA_MODEL=meta-llama/Llama-3.1-8B-Instruct

# InternVL3 Vision models require a separately deployed OpenAI-compatible endpoint.
BRANDMATE_INTERNVL_BASE_URL=
BRANDMATE_INTERNVL_API_KEY=

# Hugging Face Router / 호스팅 LLM 설정
# HF Router를 문구 생성 모델 경로로 사용할 때 필요하다.
BRANDMATE_LLM_BASE_URL=https://router.huggingface.co/v1
BRANDMATE_LLM_API_KEY=hf_your_token_here
BRANDMATE_LLM_TIMEOUT_SECONDS=120
BRANDMATE_QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct

# NVIDIA NIM 무료 시험용 엔드포인트
BRANDMATE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1


# OpenAI GPT / 비전 / 이미지 생성 설정
# 채팅/문구 모델을 OpenAI로 사용할 경우 필요하다.
BRANDMATE_OPENAI_BASE_URL=https://api.openai.com/v1
BRANDMATE_OPENAI_API_KEY=sk_your_openai_key_here
BRANDMATE_OPENAI_TTS_MODEL=gpt-4o-mini-tts
BRANDMATE_OPENAI_TTS_FALLBACK_MODELS=tts-1-hd,tts-1
BRANDMATE_OPENAI_TTS_VOICE=coral
BRANDMATE_OPENAI_TTS_FORMAT=mp3
BRANDMATE_OPENAI_TTS_TIMEOUT_SECONDS=120
BRANDMATE_VOICE_PROVIDER=openai
BRANDMATE_COSYVOICE_BASE_URL=http://127.0.0.1:50000
BRANDMATE_COSYVOICE_MODEL=Fun-CosyVoice3-0.5B-2512
BRANDMATE_COSYVOICE_TIMEOUT_SECONDS=180
BRANDMATE_COSYVOICE_HEALTH_TIMEOUT_SECONDS=2
BRANDMATE_COSYVOICE_FALLBACK_TO_OPENAI=true
BRANDMATE_OPENAI_CHAT_MODEL=gpt-5.5
BRANDMATE_OPENAI_VISION_MODEL=gpt-5.4-mini
BRANDMATE_OPENAI_IMAGE_MODEL=gpt-image-1-mini
BRANDMATE_OPENAI_GPT_5_5_MODEL=gpt-5.5
BRANDMATE_OPENAI_GPT_5_4_MODEL=gpt-5.4
BRANDMATE_OPENAI_GPT_5_4_MINI_MODEL=gpt-5.4-mini
BRANDMATE_OPENAI_GPT_5_4_NANO_MODEL=gpt-5.4-nano
BRANDMATE_OPENAI_GPT_4_1_MINI_MODEL=gpt-4.1-mini

# 로컬 ComfyUI / FLUX 이미지 생성 설정
# FastAPI와 ComfyUI가 같은 GCP VM에서 실행되므로 localhost로 연결한다.
BRANDMATE_COMFYUI_BASE_URL=http://127.0.0.1:8188
BRANDMATE_COMFYUI_WORKFLOW_PATH=
BRANDMATE_COMFYUI_TIMEOUT_SECONDS=300
BRANDMATE_COMFYUI_POLL_INTERVAL_SECONDS=1
BRANDMATE_COMFYUI_HEALTH_TIMEOUT_SECONDS=1
BRANDMATE_IMAGE_PROVIDER=comfyui
BRANDMATE_HF_IMAGE_PROVIDER=auto
BRANDMATE_HF_IMAGE_EDIT_MODEL=black-forest-labs/FLUX.1-Kontext-dev
BRANDMATE_IMAGE_PROMPT_TEMPLATE=generic

# GPT 비전 이미지 검증
BRANDMATE_IMAGE_VALIDATION_ENABLED=false
BRANDMATE_IMAGE_VALIDATOR_MODEL_NAME=gpt-5.4-mini
BRANDMATE_NVIDIA_API_KEY=nvidia_api_your_key_here

# 정적 웹 공개 주소. BRANDMATE_AUTH_PUBLIC_WEB_URL과 같은 origin이어야 합니다.
BRANDMATE_WEB_ORIGIN=https://brandmate.example.com
# 추가 origin이 필요하면 쉼표로 구분합니다. wildcard(*)는 사용하지 않습니다.
BRANDMATE_ADDITIONAL_WEB_ORIGINS=

# 공식 processed v2 TrendCard payload. 상대 경로는 저장소 루트 기준이다.
BRANDMATE_TREND_CARD_PAYLOAD_PATH=data/processed/sns_trend/v2/cross_platform_signal_top_candidates/cross_platform_signal_top_candidates.json

# SNS trend crawler API credentials.
# 로컬에서는 이 파일을 apps/api/.env로 복사하고, GCP/Airflow에서는 같은
# 환경 변수 이름을 Secret Manager 또는 Airflow Connection으로 주입한다.
YOUTUBE_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 이미지 모델 ID 설정
# BRANDMATE_IMAGE_PROVIDER=comfyui인 경우, 실제 모델 로딩은 ComfyUI 워크플로우와
# ~/ComfyUI/models 아래 파일들이 담당한다.
# 아래 값은 API 카탈로그/평가에서 사용할 논리적 모델 ID를 맞추기 위한 설정이다.
BRANDMATE_FLUX_MODEL=black-forest-labs/FLUX.1-schnell
BRANDMATE_SDXL_MODEL=stabilityai/stable-diffusion-xl-base-1.0
BRANDMATE_OPENJOURNEY_MODEL=prompthero/openjourney
