# Common API settings
BRANDMATE_LLM_TIMEOUT_SECONDS=120
BRANDMATE_WEB_ORIGIN=http://localhost:5500

# Hugging Face Router for optional hosted LLM use
BRANDMATE_LLM_BASE_URL=https://router.huggingface.co/v1
BRANDMATE_LLM_API_KEY=hf_your_token_here

# Image generation default: GCP GPU VM local ComfyUI
BRANDMATE_IMAGE_PROVIDER=comfyui
BRANDMATE_HF_IMAGE_PROVIDER=auto
BRANDMATE_HF_IMAGE_EDIT_MODEL=black-forest-labs/FLUX.1-Kontext-dev
BRANDMATE_IMAGE_PROMPT_TEMPLATE=generic
BRANDMATE_COMFYUI_BASE_URL=http://127.0.0.1:8188
BRANDMATE_COMFYUI_WORKFLOW_PATH=
BRANDMATE_COMFYUI_TIMEOUT_SECONDS=300
BRANDMATE_COMFYUI_POLL_INTERVAL_SECONDS=1
BRANDMATE_IMAGE_VALIDATION_ENABLED=false
BRANDMATE_IMAGE_VALIDATOR_MODEL_NAME=
BRANDMATE_IMAGE_VALIDATION_THRESHOLD=0.24

# OpenAI GPT / Vision / Image generation
# Used by the "openai/gpt-4.1-mini" copy model, GPT Vision image validation,
# and the OpenAI image generation models.
BRANDMATE_OPENAI_BASE_URL=https://api.openai.com/v1
BRANDMATE_OPENAI_API_KEY=sk_your_openai_key_here
BRANDMATE_OPENAI_CHAT_MODEL=gpt-5.5
BRANDMATE_OPENAI_VISION_MODEL=gpt-5.4-mini
BRANDMATE_OPENAI_IMAGE_MODEL=gpt-image-1-mini
BRANDMATE_OPENAI_GPT_5_5_MODEL=gpt-5.5
BRANDMATE_OPENAI_GPT_5_4_MODEL=gpt-5.4
BRANDMATE_OPENAI_GPT_5_4_MINI_MODEL=gpt-5.4-mini
BRANDMATE_OPENAI_GPT_5_4_NANO_MODEL=gpt-5.4-nano
BRANDMATE_OPENAI_GPT_4_1_MINI_MODEL=gpt-4.1-mini

# NVIDIA NIM optional hosted LLM endpoint
BRANDMATE_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
BRANDMATE_NVIDIA_API_KEY=
BRANDMATE_NVIDIA_LLAMA_MODEL=meta/llama-3.1-8b-instruct

# Optional reference-image visual profile cache.
# Stores only extracted visual traits and source metadata, not image files.
BRANDMATE_REFERENCE_SEARCH_ENABLED=false
BRANDMATE_REFERENCE_SOURCE=wikimedia
BRANDMATE_REFERENCE_MAX_RESULTS=3
BRANDMATE_PRODUCT_VISUAL_DB_PATH=product_visual_profiles.sqlite3
BRANDMATE_PEXELS_API_KEY=
BRANDMATE_UNSPLASH_ACCESS_KEY=

# LM Studio shared OpenAI-compatible endpoint
# Start LM Studio Local Server and verify with:
# curl http://localhost:1234/v1/models
BRANDMATE_LOCAL_LLM_BASE_URL=http://localhost:1234/v1
BRANDMATE_LOCAL_LLM_API_KEY=

# LM Studio model ids. Use the id values returned from /v1/models.
BRANDMATE_MISTRAL_MODEL=lm_studio_mistral_model_id
BRANDMATE_GEMMA_MODEL=lm_studio_gemma_model_id
BRANDMATE_PHI_MODEL=lm_studio_phi_model_id
BRANDMATE_SOLAR_MODEL=lm_studio_solar_model_id

# Optional model-specific endpoints. Use these when each model has its own server.
BRANDMATE_MISTRAL_BASE_URL=
BRANDMATE_MISTRAL_API_KEY=
BRANDMATE_GEMMA_BASE_URL=
BRANDMATE_GEMMA_API_KEY=
BRANDMATE_PHI_BASE_URL=
BRANDMATE_PHI_API_KEY=
BRANDMATE_SOLAR_BASE_URL=
BRANDMATE_SOLAR_API_KEY=

# Optional Qwen/Llama overrides for Ollama, LM Studio, vLLM, RunPod, etc.
BRANDMATE_QWEN_BASE_URL=
BRANDMATE_QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct
BRANDMATE_QWEN_API_KEY=
BRANDMATE_LLAMA_BASE_URL=
BRANDMATE_LLAMA_MODEL=meta-llama/Llama-3.1-8B-Instruct
BRANDMATE_LLAMA_API_KEY=

# InternVL3 Vision models require an OpenAI-compatible local/vLLM endpoint.
BRANDMATE_INTERNVL_BASE_URL=
BRANDMATE_INTERNVL_API_KEY=

# Diffusers image model overrides
BRANDMATE_FLUX_MODEL=black-forest-labs/FLUX.1-schnell
BRANDMATE_SDXL_MODEL=stabilityai/stable-diffusion-xl-base-1.0
BRANDMATE_OPENJOURNEY_MODEL=prompthero/openjourney

# 네이버 블로그 업로드 음식 사진의 전경을 보존하고, 같은 저장소 안의
# food-image-cleanup-pipeline으로 업종별 빈 광고 배경을 생성·합성합니다.
# 파이프라인 requirements-local.txt와 모델을 준비한 GPU 환경에서만 true로 설정합니다.
BRANDMATE_NAVER_IMAGE_ENHANCEMENT_ENABLED=false
BRANDMATE_NAVER_IMAGE_CLEANUP_ROOT=food-image-cleanup-pipeline
# API Python과 다른 파이프라인 전용 Python을 쓸 때만 절대 경로를 설정합니다.
BRANDMATE_NAVER_IMAGE_CLEANUP_PYTHON=
BRANDMATE_NAVER_IMAGE_CLEANUP_TIMEOUT_SECONDS=600
